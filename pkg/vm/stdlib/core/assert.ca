// core.assert - Testing assertions
// All assertions require a label as the first argument

// eq asserts that actual equals expected
func! eq(label, actual, expected) = match actual == expected
    true => __println(concat("  ✓ ", concat(label, concat(": ", concat(to_string(actual), " == ", to_string(expected))))))
    false => __println(concat("  ✗ ", concat(label, concat(": Expected ", concat(to_string(expected), concat(", got ", to_string(actual)))))));

// neq asserts that actual does not equal expected
func! neq(label, actual, expected) = match actual == expected
    false => __println(concat("  ✓ ", concat(label, concat(": ", concat(to_string(actual), " != ", to_string(expected))))))
    true => __println(concat("  ✗ ", concat(label, concat(": Expected not equal to ", to_string(expected)))));

// ok asserts that value is truthy
func! ok(label, value) = match value
    true => __println(concat("  ✓ ", label))
    false => __println(concat("  ✗ ", concat(label, ": Expected truthy value, got false")))
    _ => __println(concat("  ✓ ", label));

// is_true asserts that value is exactly true
func! is_true(label, value) = match value
    true => __println(concat("  ✓ ", label))
    _ => __println(concat("  ✗ ", concat(label, concat(": Expected true, got ", to_string(value)))));

// is_false asserts that value is exactly false
func! is_false(label, value) = match value
    false => __println(concat("  ✓ ", label))
    _ => __println(concat("  ✗ ", concat(label, concat(": Expected false, got ", to_string(value)))));

// is_null asserts that value is null
func! is_null(label, value) = match __type_of(value)
    "null" => __println(concat("  ✓ ", label))
    _ => __println(concat("  ✗ ", concat(label, concat(": Expected null, got ", to_string(value)))));

// is_type asserts that value has the expected type
func! is_type(label, value, expected_type) = match __type_of(value) == expected_type
    true => __println(concat("  ✓ ", concat(label, concat(": ", expected_type))))
    false => __println(concat("  ✗ ", concat(label, concat(": Expected ", concat(expected_type, concat(", got ", __type_of(value)))))));

// fail explicitly fails with a message
func! fail(label) = __println(concat("  ✗ ", label));

// throws asserts that a result is a failure
func! throws(label, result) = match __type_of(result)
    "failure" => __println(concat("  ✓ ", label))
    _ => __println(concat("  ✗ ", concat(label, concat(": Expected failure, got ", to_string(result)))));

// succeeds asserts that a result is a success
func! succeeds(label, result) = match __type_of(result)
    "success" => __println(concat("  ✓ ", label))
    _ => __println(concat("  ✗ ", concat(label, concat(": Expected success, got ", to_string(result)))));

// contains asserts that an array contains an element
func! contains(label, arr, element) = match _array_contains(arr, element)
    true => __println(concat("  ✓ ", label))
    false => __println(concat("  ✗ ", concat(label, concat(": Expected array to contain ", to_string(element)))));

func _array_contains(arr, element) = match len(arr)
    0 => false
    _ => match head(arr) == element
        true => true
        false => _array_contains(tail(arr), element);

// len_eq asserts that the length of a value equals expected
func! len_eq(label, value, expected) = match len(value) == expected
    true => __println(concat("  ✓ ", concat(label, concat(": length ", to_string(expected)))))
    false => __println(concat("  ✗ ", concat(label, concat(": Expected length ", concat(to_string(expected), concat(", got ", to_string(len(value))))))));

// gt asserts that actual > expected
func! gt(label, actual, expected) = match actual > expected
    true => __println(concat("  ✓ ", concat(label, concat(": ", concat(to_string(actual), concat(" > ", to_string(expected)))))))
    false => __println(concat("  ✗ ", concat(label, concat(": Expected ", concat(to_string(actual), concat(" > ", to_string(expected)))))));

// gte asserts that actual >= expected
func! gte(label, actual, expected) = match actual >= expected
    true => __println(concat("  ✓ ", concat(label, concat(": ", concat(to_string(actual), concat(" >= ", to_string(expected)))))))
    false => __println(concat("  ✗ ", concat(label, concat(": Expected ", concat(to_string(actual), concat(" >= ", to_string(expected)))))));

// lt asserts that actual < expected
func! lt(label, actual, expected) = match actual < expected
    true => __println(concat("  ✓ ", concat(label, concat(": ", concat(to_string(actual), concat(" < ", to_string(expected)))))))
    false => __println(concat("  ✗ ", concat(label, concat(": Expected ", concat(to_string(actual), concat(" < ", to_string(expected)))))));

// lte asserts that actual <= expected
func! lte(label, actual, expected) = match actual <= expected
    true => __println(concat("  ✓ ", concat(label, concat(": ", concat(to_string(actual), concat(" <= ", to_string(expected)))))))
    false => __println(concat("  ✗ ", concat(label, concat(": Expected ", concat(to_string(actual), concat(" <= ", to_string(expected)))))));

// not_null asserts that value is not null
func! not_null(label, value) = match __type_of(value)
    "null" => __println(concat("  ✗ ", concat(label, ": Expected non-null value, got null")))
    _ => __println(concat("  ✓ ", label));

// near asserts that two numbers are approximately equal (within epsilon)
func! near(label, actual, expected, epsilon) = match _abs_diff(actual, expected) <= epsilon
    true => __println(concat("  ✓ ", concat(label, concat(": ", concat(to_string(actual), concat(" ≈ ", to_string(expected)))))))
    false => __println(concat("  ✗ ", concat(label, concat(": Expected ", concat(to_string(actual), concat(" ≈ ", concat(to_string(expected), concat(" (epsilon: ", concat(to_string(epsilon), ")")))))))));

func _abs_diff(a, b) = match a >= b
    true => a - b
    false => b - a;

// between asserts that value is in the range [low, high]
func! between(label, value, low, high) = match value >= low
    true => match value <= high
        true => __println(concat("  ✓ ", concat(label, concat(": ", concat(to_string(value), concat(" in [", concat(to_string(low), concat(", ", concat(to_string(high), "]")))))))))
        false => __println(concat("  ✗ ", concat(label, concat(": ", concat(to_string(value), concat(" is not in [", concat(to_string(low), concat(", ", concat(to_string(high), "]")))))))))
    false => __println(concat("  ✗ ", concat(label, concat(": ", concat(to_string(value), concat(" is not in [", concat(to_string(low), concat(", ", concat(to_string(high), "]")))))))));

// matches asserts that a string contains a substring
func! matches(label, actual, pattern) = match __str_contains(to_string(actual), pattern)
    true => __println(concat("  ✓ ", concat(label, concat(": contains '", concat(pattern, "'")))))
    false => __println(concat("  ✗ ", concat(label, concat(": '", concat(to_string(actual), concat("' does not contain '", concat(pattern, "'")))))));

// not_matches asserts that a string does NOT contain a substring
func! not_matches(label, actual, pattern) = match __str_contains(to_string(actual), pattern)
    false => __println(concat("  ✓ ", concat(label, concat(": does not contain '", concat(pattern, "'")))))
    true => __println(concat("  ✗ ", concat(label, concat(": '", concat(to_string(actual), concat("' should not contain '", concat(pattern, "'")))))));

// section prints a section header
func! section(name) = __println(concat("\n", concat(name, ":")));
