{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Calcium",
  "scopeName": "source.calcium",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.calcium",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.calcium",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.calcium",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.expression.calcium",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [{ "include": "$self" }]
            }
          ]
        },
        {
          "name": "string.regexp.calcium",
          "match": "/[^/\\n]*/[imsgu]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.calcium",
          "match": "\\b(match|do|end|return|in)\\b"
        },
        {
          "name": "keyword.declaration.calcium",
          "match": "\\b(func!?|constraint|namespace|use|type)\\b"
        },
        {
          "name": "constant.language.calcium",
          "match": "\\b(true|false|success|failure)\\b"
        },
        {
          "name": "variable.language.calcium",
          "match": "\\b(_)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.calcium",
          "match": "\\b(map|filter|reduce|has|keys|values|hash|len)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.calcium",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.calcium",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.calcium",
          "match": "(\\|>\\??|!>|!\\?)"
        },
        {
          "name": "keyword.operator.arrow.calcium",
          "match": "=>"
        },
        {
          "name": "keyword.operator.spread.calcium",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.comparison.calcium",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.calcium",
          "match": "(&&|\\|\\|)"
        },
        {
          "name": "keyword.operator.arithmetic.calcium",
          "match": "(\\*\\*|[+\\-*/%])"
        },
        {
          "name": "keyword.operator.assignment.calcium",
          "match": "="
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.calcium",
          "match": "(?<=func!?\\s)[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "entity.name.type.calcium",
          "match": "(?<=type\\s)[A-Z][a-zA-Z0-9_]*"
        },
        {
          "name": "entity.name.class.calcium",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.other.calcium",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
