// Pattern Matching Test
use core.io!;
use core.assert!;

io.println("Pattern Matching Tests");
io.println("=====================");

// === Literal Matching ===
assert.section("Literal matching");
func describe_num(n) = match n
    0 => "zero"
    1 => "one"
    2 => "two"
    _ => "many";

assert.eq("match 0", describe_num(0), "zero");
assert.eq("match 1", describe_num(1), "one");
assert.eq("match 2", describe_num(2), "two");
assert.eq("match wildcard", describe_num(100), "many");

// === Boolean Matching ===
assert.section("Boolean matching");
func bool_to_str(b) = match b
    true => "yes"
    false => "no";

assert.eq("match true", bool_to_str(true), "yes");
assert.eq("match false", bool_to_str(false), "no");

// === String Matching ===
assert.section("String matching");
func greet(name) = match name
    "Alice" => "Hello, Alice!"
    "Bob" => "Hi, Bob!"
    _ => concat("Welcome, ", name);

assert.eq("match Alice", greet("Alice"), "Hello, Alice!");
assert.eq("match Bob", greet("Bob"), "Hi, Bob!");
assert.eq("match other", greet("Charlie"), "Welcome, Charlie");

// === Wildcard ===
assert.section("Wildcard");
func always_default(x) = match x
    _ => "default";

assert.eq("wildcard int", always_default(1), "default");
assert.eq("wildcard string", always_default("hello"), "default");
assert.eq("wildcard bool", always_default(true), "default");

// === Recursive Pattern Matching ===
assert.section("Recursive with match");
func sum_list(lst) = match len(lst)
    0 => 0
    _ => head(lst) + sum_list(tail(lst));

assert.eq("sum empty list", sum_list([]), 0);
assert.eq("sum [1..5]", sum_list([1, 2, 3, 4, 5]), 15);

// === Nested Match ===
assert.section("Nested match");
func classify_positive(x) = match x > 100
    true => "large positive"
    false => "small positive";

func classify_non_positive(x) = match x < 0
    true => "negative"
    false => "zero";

func classify(x) = match x > 0
    true => classify_positive(x)
    false => classify_non_positive(x);

assert.eq("classify 500", classify(500), "large positive");
assert.eq("classify 50", classify(50), "small positive");
assert.eq("classify 0", classify(0), "zero");
assert.eq("classify -10", classify(-10), "negative");

io.println("\n=====================");
io.println("Match tests complete!");
