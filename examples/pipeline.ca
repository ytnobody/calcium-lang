// Pipeline demonstration in Calcium
use core.io!;
use core.array;

// Data generation
numbers = range(1, 11);

"Original numbers:" !> io.say;
numbers !> io.say;

// Pipeline chain: filter even numbers → double → sum
result = numbers
    |> filter(x => x % 2 == 0)
    |> map(x => x * 2)
    |> reduce((a, b) => a + b, 0);

"Sum of doubled even numbers:" !> io.say;
result !> io.say;

// Array operations using pipeline
"Reversed:" !> io.say;
numbers |> array.reverse !> io.say;

"First 5:" !> io.say;
numbers |> (arr => array.take(arr, 5)) !> io.say;

"Sum:" !> io.say;
numbers |> array.sum !> io.say;

// Compound pipeline: filter odd numbers, cube them, and sum
"Sum of cubes of odd numbers (1³+3³+5³+7³+9³):" !> io.say;
numbers
    |> filter(x => x % 2 == 1)
    |> map(x => x * x * x)
    |> array.sum
    !> io.say;

// Define FizzBuzz functions
func fizz(n) = match n % 3  0 => "Fizz"  _ => "";
func buzz(n) = match n % 5  0 => "Buzz"  _ => "";

func fizzbuzz_or(result, n) = match result
    "" => to_string(n)
    _ => result;

func fizzbuzz(n) = fizz(n) + buzz(n) |> fizzbuzz_or(n);

// FizzBuzz pipeline
"FizzBuzz (1-15):" !> io.say;
range(1, 16) |> map(fizzbuzz) !> io.say;
