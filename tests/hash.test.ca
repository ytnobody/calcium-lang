// Hash Operations Test
use core.io!;
use core.assert!;

io.println("Hash Tests");
io.println("==========");

// === Basic Operations ===
assert.section("Basic operations");
h = {a: 1, b: 2, c: 3};
assert.eq("dot access a", h.a, 1);
assert.eq("bracket access b", h["b"], 2);
assert.eq("dot access c", h.c, 3);

// === Keys and Values ===
assert.section("Keys and values");
assert.len_eq("keys count", keys(h), 3);
assert.len_eq("values count", values(h), 3);
assert.contains("has key a", keys(h), "a");
assert.contains("has key b", keys(h), "b");
assert.contains("has value 1", values(h), 1);
assert.contains("has value 2", values(h), 2);

// === Empty Hash ===
assert.section("Empty hash");
empty = {};
assert.len_eq("empty keys", keys(empty), 0);

// === Nested Hash ===
assert.section("Nested hash");
nested = {
    outer: {
        inner: 42
    }
};
assert.eq("nested dot access", nested.outer.inner, 42);
assert.eq("nested bracket access", nested["outer"]["inner"], 42);

// === hash_set ===
assert.section("hash_set");
h1 = {a: 1};
h2 = hash_set(h1, "b", 2);
assert.eq("original key", h2.a, 1);
assert.eq("added key", h2.b, 2);
assert.len_eq("keys after add", keys(h2), 2);

// hash_set replaces existing key
h3 = hash_set(h2, "a", 100);
assert.eq("replaced key", h3.a, 100);
assert.eq("unchanged key", h3.b, 2);

// === hash_merge ===
assert.section("hash_merge");
left = {a: 1, b: 2};
right = {b: 20, c: 3};
merged = hash_merge(left, right);
assert.eq("left only key", merged.a, 1);
assert.eq("overwritten key", merged.b, 20);
assert.eq("right only key", merged.c, 3);

// === has ===
assert.section("has");
assert.is_true("has existing key", has(h, "a"));
assert.is_false("has missing key", has(h, "x"));

// === get ===
assert.section("get");
assert.eq("get existing", get(h, "a"), 1);

// === Mixed Value Types ===
assert.section("Mixed value types");
mixed = {
    num: 42,
    str: "hello",
    bool: true,
    arr: [1, 2, 3],
    nested: {x: 1}
};
assert.eq("num value", mixed.num, 42);
assert.eq("str value", mixed.str, "hello");
assert.is_true("bool value", mixed.bool);
assert.len_eq("arr value", mixed.arr, 3);
assert.eq("nested value", mixed.nested.x, 1);

io.println("\n==========");
io.println("Hash tests complete!");
