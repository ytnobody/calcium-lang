// Result Handling Test (!? operator)
use core.io!;
use core.assert!;
use core.types;

io.println("Result Handling Tests");
io.println("====================");

// === Success/Failure Creation ===
assert.section("Success/Failure creation");
s = success(42);
f = failure("error");
assert.eq("success type", types.type_of(s), "success");
assert.eq("failure type", types.type_of(f), "failure");

// === Basic !? Handling ===
assert.section("Basic !? handling");
result1 = success(42) !? {
    success(v) => v
    failure(err) => 0
};
assert.eq("unwrap success", result1, 42);

result2 = failure("error") !? {
    success(v) => v
    failure(err) => 0
};
assert.eq("unwrap failure", result2, 0);

// === Effect Functions ===
assert.section("Effect functions returning results");
func safe_divide(a, b) = match b == 0
    true => failure("division by zero")
    false => success(a / b);

safe_divide(10, 2) !? {
    success(v) => assert.eq("divide success", v, 5)
    failure(err) => assert.fail("should not fail")
};

safe_divide(10, 0) !? {
    success(v) => assert.fail("should fail")
    failure(e) => assert.eq("divide by zero error", e, "division by zero")
};

// === Result Unwrapping Helper ===
assert.section("Result unwrapping");
func unwrap_or(result, default_val) = result !? {
    success(v) => v
    failure(err) => default_val
};

assert.eq("unwrap_or success", unwrap_or(success(42), 0), 42);
assert.eq("unwrap_or failure", unwrap_or(failure("error"), 0), 0);

// === Simple Chaining ===
assert.section("Simple chaining");
func add_one(x) = success(x + 1);

chain_result = add_one(1);
v1 = unwrap_or(chain_result, 0);
chain_result2 = add_one(v1);
v2 = unwrap_or(chain_result2, 0);
assert.eq("chained result", v2, 3);

// === Result in Function Body ===
assert.section("Result in function body");
func safe_sqrt(x) = match x >= 0
    true => success(x)
    false => failure("negative number");

func process(x) = safe_sqrt(x) !? {
    success(v) => v * 2
    failure(err) => -1
};

assert.eq("process positive", process(16), 32);
assert.eq("process negative", process(-4), -1);

// === Step Functions for Pipeline ===
assert.section("Propagating failures");
func step1(x) = success(x + 10);
func step2(x) = match x > 50
    true => failure("too large")
    false => success(x * 2);
func step3(x) = success(x - 5);

// Helper to chain steps
func chain_step1(x) = step1(x);
func chain_step2(r) = r !? {
    success(v) => step2(v)
    failure(e) => failure(e)
};
func chain_step3(r) = r !? {
    success(v) => step3(v)
    failure(e) => failure(e)
};

// Pipeline using helper functions
func run_pipeline(x) = chain_step3(chain_step2(chain_step1(x)));

run_pipeline(10) !? {
    success(v) => assert.eq("pipeline success", v, 35)
    failure(err) => assert.fail("should succeed")
};

run_pipeline(50) !? {
    success(v) => assert.fail("should fail")
    failure(e) => assert.eq("pipeline failure", e, "too large")
};

io.println("\n====================");
io.println("Result tests complete!");
