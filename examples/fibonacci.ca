// Fibonacci example in Calcium
use core.io;

// Recursive Fibonacci
func fib(n) = match n
    0 => 0
    1 => 1
    true => fib(n - 1) + fib(n - 2);

func build_fib_message(n) = n
    |> fib
    |> (r => concat("fib(", to_string(n), ") = ", to_string(r)));

// Output Fibonacci sequence
"Fibonacci sequence:" |> io.say;

result = range(0, 15) |> map(
    n => build_fib_message(n) |> io.say
);

// Check how it approaches the golden ratio
"" |> io.say;
"Ratio fib(n)/fib(n-1) approaches golden ratio:" |> io.say;

result = range(2, 15) |> map(n =>
    concat(
        "fib(", to_string(n), ")/fib(", to_string(n - 1), ") = ",
        to_string(fib(n)), "/", to_string(fib(n - 1))
    ) |> io.say
);
